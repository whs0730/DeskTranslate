<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity">

    <com.whs0730.desktranslate.ui.LiquidBackdropView
        android:id="@+id/liquidBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <!-- Top bar: title + active provider badge + top-right Liquid Glass Settings button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.02"
                        android:text="@string/screen_title"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <com.whs0730.desktranslate.ui.LiquidGlassLinearLayout
                        android:id="@+id/providerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp"
                        android:paddingEnd="10dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_status_dot" />

                        <TextView
                            android:id="@+id/providerBadgeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/provider_badge_mymemory"
                            android:textColor="@color/glass_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </com.whs0730.desktranslate.ui.LiquidGlassLinearLayout>
                </LinearLayout>

                <com.whs0730.desktranslate.ui.LiquidGlassFrameLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:clickable="true"
                    android:contentDescription="@string/settings"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings" />
                </com.whs0730.desktranslate.ui.LiquidGlassFrameLayout>
            </LinearLayout>

            <!-- Translation direction Liquid Glass segmented control placed above source input -->
            <com.whs0730.desktranslate.ui.LiquidGlassFrameLayout
                android:id="@+id/directionTrack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="4dp">

                <com.whs0730.desktranslate.ui.LiquidGlassPillView
                    android:id="@+id/directionThumb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/directionAuto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/direction_auto"
                        android:textColor="@color/mint_accent_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/directionZhToEn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/direction_zh_to_en"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/directionEnToZh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/direction_en_to_zh"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.whs0730.desktranslate.ui.LiquidGlassFrameLayout>

            <!-- Source Liquid Glass panel: top-right Clear, bottom-right compact Mint Translate pill -->
            <com.whs0730.desktranslate.ui.LiquidGlassLinearLayout
                android:id="@+id/sourcePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/source_title"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clearButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_glass_ghost_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/clear"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/glass_divider" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/sourceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/source_hint"
                    android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="8"
                    android:minLines="5"
                    android:paddingStart="0dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/glass_text_primary"
                    android:textColorHint="@color/glass_text_placeholder"
                    android:textSize="16sp" />

                <!-- Bottom row inside source panel: counter on left, compact Mint Glass Translate button on bottom-right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/byteCounter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/glass_text_placeholder"
                        android:textSize="12sp"
                        tools:text="0 / 500 字节" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/loadingIndicator"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/translating"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/mint_indicator"
                        app:indicatorSize="20dp"
                        app:trackThickness="2.5dp" />

                    <com.whs0730.desktranslate.ui.LiquidGlassLinearLayout
                        android:id="@+id/translateButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="86dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/translateButtonText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/translate"
                            android:textColor="@color/mint_button_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/translateButtonIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="5dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_forward" />
                    </com.whs0730.desktranslate.ui.LiquidGlassLinearLayout>
                </LinearLayout>
            </com.whs0730.desktranslate.ui.LiquidGlassLinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/glass_error"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="当前输入为纯英文，请切换到「英译中」后再翻译。"
                tools:visibility="visible" />

            <!-- Result Liquid Glass panel -->
            <com.whs0730.desktranslate.ui.LiquidGlassLinearLayout
                android:id="@+id/resultPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:id="@+id/resultHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resultTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_title"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/copyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:alpha="0.38"
                        android:background="@drawable/bg_glass_ghost_button"
                        android:clickable="true"
                        android:enabled="false"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/copy"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/glass_divider" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:minHeight="132dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="6dp"
                    android:text="@string/result_placeholder"
                    android:textColor="@color/glass_text_placeholder"
                    android:textIsSelectable="true"
                    android:textSize="18sp"
                    tools:text="译文会显示在这里" />

                <TextView
                    android:id="@+id/resultPhonetic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:paddingStart="0dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/glass_text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="13.5sp"
                    android:visibility="gone"
                    tools:text="/rʌn/"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/resultAlternatives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/glass_text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="13.5sp"
                    android:visibility="gone"
                    tools:text="其他译法：跑 · 经营 · 运转"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/resultDictDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/glass_divider"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/resultDictionaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="6dp"
                    android:visibility="gone" />
            </com.whs0730.desktranslate.ui.LiquidGlassLinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</merge>
