<?xml version="1.0" encoding="utf-8"?>
<com.whs0730.desktranslate.ui.LiquidGlassLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/configRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/configRadio"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_glass_radio" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/configName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/glass_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="配置 1" />

        <TextView
            android:id="@+id/configMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/glass_text_secondary"
            android:textSize="11.5sp"
            tools:text="deepseek-flash · sk-…7890" />
    </LinearLayout>

    <TextView
        android:id="@+id/configEditButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_glass_ghost_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/api_config_edit"
        android:textColor="@color/mint_accent_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/configDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_glass_ghost_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/api_config_delete"
        android:textColor="@color/glass_error"
        android:textSize="13sp"
        android:textStyle="bold" />
</com.whs0730.desktranslate.ui.LiquidGlassLinearLayout>
